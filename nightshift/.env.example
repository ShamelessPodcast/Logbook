# =====================================================================
# Nightshift — environment
# Copy to .env.local for local development; set the same keys in Vercel.
# =====================================================================

# ── Database (required) ──────────────────────────────────────────────
# Supabase project URL and SERVICE ROLE key. The service key bypasses RLS
# and is only ever used server-side. Never expose it to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Model access ─────────────────────────────────────────────────────
# Without this Nightshift still runs, but in dry-run mode: it polls your
# sources and records what it finds, and does no thinking at all.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# NIGHTSHIFT_MODEL=claude-opus-5

# ── Autonomy ─────────────────────────────────────────────────────────
# dry_run       — think, record, execute nothing
# low_risk_live — execute low-risk actions; queue the rest   (default)
# full_live     — execute low and medium risk
# High-risk actions never run automatically at any level.
NIGHTSHIFT_AUTONOMY=low_risk_live

# ── Access control ───────────────────────────────────────────────────
# Protects /api/cron/*. Vercel Cron sends this as a bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate_a_long_random_string

# Password for the dashboard. Leave unset and the dashboard is public.
NIGHTSHIFT_PASSWORD=choose_something_long

# ── Connectors ───────────────────────────────────────────────────────
# Read-only GitHub token. Needed for private repos; public repos work
# without one but are heavily rate-limited.
# Fine-grained token, "Contents: read" and "Issues: read" is enough.
GITHUB_TOKEN=

# ── Cost and time ceilings ───────────────────────────────────────────
# NIGHTSHIFT_MAX_PROJECTS=25
# NIGHTSHIFT_MAX_ACTIONS=40
# NIGHTSHIFT_MAX_SPEND_PENNIES=200
# Wall clock per serverless invocation before the run checkpoints itself.
# Keep comfortably below the route's maxDuration (300s).
# NIGHTSHIFT_BUDGET_MS=240000

# ── Cosmetic ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NIGHTSHIFT_TIMEZONE=Europe/London
